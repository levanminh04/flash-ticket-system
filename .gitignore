# ============================================================================
# TicketBox .gitignore
# ============================================================================

# Environment Variables (CRITICAL - NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# Build outputs
target/
build/
out/
*.class
*.jar
*.war
*.ear

# Logs
logs/
*.log
*.log.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node (if using frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Database
*.db
*.sqlite
*.sqlite3

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
.gradle/
!gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
